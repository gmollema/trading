//@version=5
indicator("RSI2 Mean Reversion Strategy", overlay=true, max_lines_count=500)

// === INPUT PARAMETERS ===
rsi_period = input(2, "RSI Period", minval=1)
entry_rsi_sp500 = input(10.0, "Entry RSI Level (S&P 500)", minval=0, maxval=100)
entry_rsi_nasdaq = input(7.0, "Entry RSI Level (Nasdaq)", minval=0, maxval=100)
exit_rsi_level = input(70.0, "Exit RSI Level (Overbought)", minval=0, maxval=100)
sma_period_sp500 = input(175, "SMA Period (S&P 500)", minval=1)
sma_period_nasdaq = input(250, "SMA Period (Nasdaq)", minval=1)
regime_filter_enabled = input(true, "Enable Regime Filter (Price > SMA)")

// === DETECT SYMBOL ===
is_sp500 = syminfo.tickerid == "FOREXCOM:SPXUSD" or syminfo.description == "S&P 500 Index" or str.contains(syminfo.description, "SPX")
is_nasdaq = syminfo.tickerid == "FOREXCOM:NSXUSD" or syminfo.description == "NASDAQ-100 Index" or str.contains(syminfo.description, "NDX")

// === SELECT PARAMETERS BASED ON SYMBOL ===
entry_level = is_nasdaq ? entry_rsi_nasdaq : entry_rsi_sp500
sma_period = is_nasdaq ? sma_period_nasdaq : sma_period_sp500

// === CALCULATIONS ===
// Wilder's RSI
rsi = ta.rsi(close, rsi_period)
sma = ta.sma(close, sma_period)

// === CONDITIONS ===
price_above_sma = close > sma
rsi_below_entry = rsi < entry_level
rsi_above_exit = rsi > exit_rsi_level

// Regime filter
regime_ok = not regime_filter_enabled or price_above_sma

// Entry signal: RSI below entry AND price above SMA (if regime filter enabled)
entry_signal = rsi_below_entry and regime_ok

// Exit signal: RSI above exit level
exit_signal = rsi_above_exit

// === PLOT SMA ===
plot(sma, "SMA", color=color.new(color.blue, 30), linewidth=2)

// === PLOT RSI LEVELS ===
hline(entry_level, "Entry RSI Level", color=color.new(color.orange, 60), linestyle=hline.style_dashed)
hline(exit_rsi_level, "Exit RSI Level", color=color.new(color.red, 60), linestyle=hline.style_dashed)

// === SIGNAL MARKERS ===
// Entry signal (green up arrow)
plotshape(entry_signal, title="BUY Signal", style=shape.triangleup, location=location.belowbar,
          color=color.new(color.green, 0), size=size.small)

// Exit signal (red down arrow)
plotshape(exit_signal, title="SELL Signal", style=shape.triangledown, location=location.abovebar,
          color=color.new(color.red, 0), size=size.small)

// === BACKGROUND HIGHLIGHTING ===
// Highlight regime filter failure
regime_fail = regime_filter_enabled and not price_above_sma
bgcolor(regime_fail ? color.new(color.red, 90) : na)

// Highlight when RSI is in entry zone
rsi_entry_zone = rsi_below_entry and not regime_fail
bgcolor(rsi_entry_zone ? color.new(color.green, 85) : na)

// === ALERTS ===
alertcondition(entry_signal, title="RSI2 BUY Signal", message="RSI2 buy signal: RSI below {{entry_level}}, Price > SMA")
alertcondition(exit_signal, title="RSI2 SELL Signal", message="RSI2 sell signal: RSI above {{exit_rsi_level}}")

// === TABLE INFO ===
var table_pos = table.new(position=position.top_right, columns=2, rows=4, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

table.cell(table_pos, 0, 0, text="RSI(2)", text_color=color.white)
table.cell(table_pos, 1, 0, text=str.tostring(rsi, "#.00"), text_color=rsi_below_entry ? color.green : color.red)

table.cell(table_pos, 0, 1, text="Price", text_color=color.white)
table.cell(table_pos, 1, 1, text=str.tostring(close, "$#.00"), text_color=color.white)

table.cell(table_pos, 0, 2, text="SMA", text_color=color.white)
table.cell(table_pos, 1, 2, text=str.tostring(sma, "$#.00"), text_color=color.white)

table.cell(table_pos, 0, 3, text="Signal", text_color=color.white)
signal_text = entry_signal ? "BUY" : exit_signal ? "SELL" : "HOLD"
signal_color = entry_signal ? color.green : exit_signal ? color.red : color.gray
table.cell(table_pos, 1, 3, text=signal_text, text_color=signal_color)
